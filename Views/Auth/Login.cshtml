@using FirstMVCProject.Dto

@model UserDto

@* Totast Notification to display the success message for user created successfully *@
@if (ViewBag.SuccessMessage != null || ViewBag.ErrorMessage != null)
{
    var isSuccess = ViewBag.SuccessMessage != null;
    var message = isSuccess ? ViewBag.SuccessMessage : ViewBag.ErrorMessage;
    var theme = isSuccess ? "text-bg-success" : "text-bg-danger";

    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="Toast" class="toast @theme border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    @message
                </div>
                <button type="button"
                        class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast"
                        aria-label="Close">
                </button>
            </div>
        </div>
    </div>


    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var toastElement = document.getElementById("Toast");

            var toast = new bootstrap.Toast(toastElement, {
                delay: 3000,   // Auto close after 3 seconds
                autohide: true
            });

            toast.show();
        });
    </script>
}



@* Login Form *@

<form class="container mt-5" style="max-width: 400px;" asp-action="LoginUser">
    <div class="card shadow p-4">
        <h3 class="text-center mb-4">Login</h3>

        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email"
                   class="form-control"
                   id="email"
                   name="email"
                   asp-for="Email"
                   placeholder="Enter your email"
                   required>
        </div>

        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input type="password"
                   class="form-control"
                   id="password"
                   name="password"
                   asp-for="Password"
                   placeholder="Enter your password"
                   required>
        </div>

        <button type="submit" class="btn btn-primary w-100">
            Login
        </button>
       
    </div>
</form>

