@using FirstMVCProject.Dto
@model UserDto


<form class="container mt-5" style="max-width: 450px;" asp-action="CreateUser">
    <div class="card shadow p-4">
        <h3 class="text-center mb-4">Registration</h3>

        <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input type="text"
                   class="form-control"
                   id="username"
                   name="username"
                   asp-for="Username"
                   placeholder="Enter your username"
                   required>
        </div>

        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email"
                   class="form-control"
                   id="email"
                   name="email"
                   asp-for="Email"
                   placeholder="Enter your email"
                   required>
        </div>

        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input type="password"
                   class="form-control"
                   id="password"
                   name="password"
                   asp-for="Password "
                   placeholder="Enter your password"
                   required>
        </div>

        <input type="submit" class="btn btn-success w-100" value="Register">
        </input>
    </div>
</form>
<a asp-action="Login" class="d-block text-center mt-3">Already have an account? Login</a>


