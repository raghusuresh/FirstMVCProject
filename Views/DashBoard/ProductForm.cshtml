@using FirstMVCProject.Dto
@model ProductDto


@* Totast Notification to display the success message for user created successfully *@
@if (ViewBag.SuccessMessage != null || ViewBag.ErrorMessage != null)
{
    var isSuccess = ViewBag.SuccessMessage != null;
    var message = isSuccess ? ViewBag.SuccessMessage : ViewBag.ErrorMessage;
    var theme = isSuccess ? "text-bg-success" : "text-bg-danger";

    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="Toast" class="toast @theme border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    @message
                </div>
                <button type="button"
                        class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast"
                        aria-label="Close">
                </button>
            </div>
        </div>
    </div>


    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var toastElement = document.getElementById("Toast");

            var toast = new bootstrap.Toast(toastElement, {
                delay: 3000,   // Auto close after 3 seconds
                autohide: true
            });

            toast.show();
        });
    </script>
}


@* ProductForm *@

<form class="container mt-5" style="max-width: 500px;" asp-action="AddProduct" asp-controller="DashBoard">

    <div class="card shadow p-4">
        <h3 class="text-center mb-4">Add Product</h3>

        <div class="mb-3">
            <label for="productName" class="form-label">Product Name</label>
            <input type="text"
                   class="form-control"
                   id="productName"
                   asp-for="ProductName"
                   placeholder="Enter product name"
                   required>
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea class="form-control"
                      id="description"
                      rows="3"
                      asp-for="Description"
                      placeholder="Enter product description"
                      required></textarea>
        </div>

        <div class="mb-3">
            <label for="price" class="form-label">Price</label>
            <input type="number"
                   class="form-control"
                   id="price"
                   asp-for="Price"
                   placeholder="Enter product price"
                   required>
        </div>

        <div class="mb-3">
            <label for="color" class="form-label">Color</label>
            <input type="text"
                   class="form-control"
                   id="color"
                   asp-for="Color"
                   placeholder="Enter product color"
                   required>
        </div>

        <button type="submit" class="btn btn-success w-100">
            Add Product
        </button>
    </div>

</form>